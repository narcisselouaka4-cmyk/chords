# Variables d'environnement pour Piano Jazz Chords
# Copiez ce fichier en .env et remplissez vos clés.
#
# Lues par electron/preload.js et exposées dans window.electronAPI.env
# Utilisées par src/ai/ai-client.js (priorité : localStorage > .env)

# Clé API pour le provider IA (Groq, OpenRouter, etc.)
# Option A : Groq (https://console.groq.com) — gratuit, rapide
IA_API_KEY=gsk_votre_cle_ici
IA_BASE_URL=https://api.groq.com/openai/v1
IA_MODEL=llama-3.1-8b-instant

# Option B : OpenRouter (https://openrouter.ai)
# IA_API_KEY=sk-or-votre_cle_ici
# IA_BASE_URL=https://openrouter.ai/api/v1
# IA_MODEL=meta-llama/llama-3.1-8b-instruct:free
