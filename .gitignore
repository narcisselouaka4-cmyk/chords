# Cache WAV du harnais de benchmark : 400+ Mo régénérables à la demande.
benchmark_outputs/harmonic/cache/
# Bytecode produit par les exécutions pytest (le dépôt ne suit que les .pyc
# générés par les runners natifs).
__pycache__/*-pytest-*.pyc

# Audio rendu de la batterie B1 : 122 Mo régénérables par
# `python3 scripts/corpus_b1.py generate`. Les .mid et .json de vérité terrain,
# eux, sont suivis : ce sont eux qui définissent le corpus.
tests/corpus/b1/*.wav
tests/corpus/b2/*.wav
tests/corpus/b3/*.wav
tests/corpus/b4/*.wav
tests/corpus/b5/*.wav

# Skills Claude Code installés localement (ui-ux-pro-max, impeccable) :
# outils de développement, réinstallables — voir CLAUDE.md § Outils de design.
.claude/skills/
apikeys

# Environnement Python local et cache pytest.
.venv/
.pytest_cache/

# Worktrees Git locaux (un répertoire par session) : jamais le contenu d'un
# autre dépôt/checkout dans celui-ci. Un seul avait été ajouté par erreur
# comme gitlink (.claude/worktrees/refonte-ui-jazz, retiré le 24/10/2026).
.claude/worktrees/

# Config locale de l'outil Codex CLI, hors du projet.
.codex/

# Sorties de QA/audit manuel (captures, logs, jsonl) : régénérables à la
# demande, pas des artefacts de build.
audit-output/

# Clone externe (papier ISMIR 2019, chord transcription) utilisé pour la
# recherche hors-dépôt : ~1,4 Go avec son venv, réinstallable via git clone.
ism2019-chord/
